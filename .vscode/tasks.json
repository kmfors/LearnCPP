{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
				"-S", "${config:DH_ENV.PROJECT_ROOT}",
				"-B", "${config:DH_ENV.BUILD_DIR}",
				"-G", "${config:DH_ENV.GENERATOR}",
				"-DCMAKE_BUILD_TYPE=${config:DH_ENV.BUILD_TYPE}",
				"-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "-DCMAKE_CXX_COMPILER=${config:DH_ENV.COMPILER_PATH}/g++.exe",
			],
			"options": { "cwd": "${config:DH_ENV.PROJECT_ROOT}" },
			"group": {
                "kind": "build",
                "isDefault": true
            },
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
            "problemMatcher": [ ],
            "detail": "CMake configuration task"
        },
        {
            "label": "CMake: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${config:DH_ENV.BUILD_DIR}",
                "--config", "${config:DH_ENV.BUILD_TYPE}",
                "-j", "${config:DH_ENV.THREAD_COUNT}"
            ],
            "options": { "cwd": "${config:DH_ENV.PROJECT_ROOT}" },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [ "$msCompile" ],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
            //"dependsOn": "CMake: configure",
			"detail": "CMake build task"
        },
        {
            "label": "Run MyCppProject",
            "type": "shell",
            "command": "${config:DH_ENV.BIN_DIR}/${config:DH_ENV.PROJECT_NAME}.exe",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "problemMatcher": []
        },
        // 执行单个文件的编译与运行（自动定位当前打开的文件位置）
        {
            "label": "Auto build and run single instance",
            "type": "shell",
            "command": "g++",
            "args": [
                "${relativeFileDirname}/${fileBasename}",
                "-std=c++11",
                "-o", "build/${fileBasenameNoExtension}.exe",
                ";", "build/${fileBasenameNoExtension}.exe"
            ],
            "group": {"kind": "test","isDefault": true },
            "presentation": {
                "echo": true,"reveal": "always",
                "focus": false,"panel": "shared"
            },
        },
        ////////////////自动化配置编译文件///////////////////////////
        {
            "label": "CMake: auto configure",
            "type": "shell",
            "command": "cmake",
            "args": [
				"-S", "${relativeFileDirname}",
				"-B", "${relativeFileDirname}/build",
				"-G", "MinGW Makefiles",
				"-DCMAKE_BUILD_TYPE=${config:DH_ENV.BUILD_TYPE}",
				"-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
				"-DCMAKE_CXX_COMPILER=${config:DH_ENV.COMPILER_PATH}/g++.exe"
			],
			"group": {"kind": "build", "isDefault": false},
			"presentation": {"reveal": "always","panel": "shared"},
            "problemMatcher": [ ],
            "detail": "CMake auto configuration task"
        },
        {
            "label": "CMake: auto build and run",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${relativeFileDirname}/build",
                "--config", "${config:DH_ENV.BUILD_TYPE}",
                "-j${config:DH_ENV.THREAD_COUNT}",
                "--target", "run"
            ],
            "group": {"kind": "build","isDefault": true },
            "problemMatcher": [ "$msCompile" ],
			"presentation": {"reveal": "always","panel": "shared"},
            "dependsOn": "CMake: auto configure",
			"detail": "CMake auto build and run task"
        },

    ]
}