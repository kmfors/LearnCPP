        <mxCell id="s6YnnTn-w_Dm97id0C-s-5" parent="n3Uo0M5FuJLSMmvL-DjQ-1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=38;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;strokeWidth=2;shadow=0;strokeColor=default;swimlaneFillColor=default;" value="&lt;span style=&quot;font-family: &amp;quot;Fira Code&amp;quot;;&quot;&gt;«interface»&lt;/span&gt;&lt;br style=&quot;font-family: &amp;quot;Fira Code&amp;quot;;&quot;&gt;&lt;b style=&quot;font-family: &amp;quot;Fira Code&amp;quot;;&quot;&gt;Product&lt;/b&gt;" vertex="1">
